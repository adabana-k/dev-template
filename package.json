{
  "name": "codex-app-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "test": "node --test tests/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "check": "npm run test && npm run lint && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "vite": "^8.0.0"
  }
}
